# Copy to .env.local and fill in. NEVER commit .env.local.
# In Vercel, set these per environment (Production / Preview / Development).

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only. NEVER prefix with NEXT_PUBLIC. Vercel: server env only.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Translation provider (async job-request translation worker) ----
# DeepL does NOT support Punjabi (pa) -> default provider is Google.
TRANSLATION_PROVIDER=google
GOOGLE_TRANSLATE_API_KEY=
# Optional: route zh-Hans through DeepL for higher quality
DEEPL_API_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
